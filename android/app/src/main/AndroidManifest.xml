<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Health Connect 권한 사용 이유(개인정보 처리방침) 화면. 지원 버전 공통 진입점. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ 전용 진입점(Health Connect 앱 내 "권한 사용 정보" 화면에서 호출). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Health Connect가 별도 앱으로 설치되는 Android 버전(14 미만)에서 패키지 존재 여부를 확인하기 위해 필요 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "오늘의 걸음" 기능 전용. 걸음 읽기만 요청하며 WRITE_STEPS 등 다른 건강 데이터 권한은 요청하지 않는다. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- foreground일 때만 사용하는 실시간 걸음 센서(TYPE_STEP_DETECTOR/COUNTER)용. API 29+에서
         런타임 권한이며, API 29 미만에서는 선언만 있고 별도 요청 없이 항상 사용 가능하다. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
</manifest>
